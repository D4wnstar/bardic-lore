    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Program",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "env": {"WEBKIT_DISABLE_DMABUF_RENDERER": "1", "RUST_LOG": "warn"},
            "runtimeExecutable": "npm",
            "args": ["run", "tauri", "dev"],
            "outFiles": [
                "${workspaceFolder}/**/*.js"
            ]
        }
    ]
}